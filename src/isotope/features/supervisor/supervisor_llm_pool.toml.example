# Codex Supervisor LLM key pool -- EXAMPLE FILE
#
# Copy this file to supervisor_llm_pool.toml and fill in your own values.
# The real supervisor_llm_pool.toml is git-ignored and never committed.
#
# Format: [[agents]] groups providers by agent role.
# Each [[agents]] can have multiple [[agents.providers]] entries.
#
# api_keys entries:
#   "env:NAME" = read from environment variable $NAME
#   plain text  = use directly as the api key
#
# Optional per-provider fields:
#   max_tokens = override the global SUPERVISOR_LLM_MAX_TOKENS default (512)
#                Use this for reasoning models that need more token budget.
#
# Codex provider fields:
#   provider = "codex" means use local Codex CLI auth/runtime, not an API key.
#   workspace_root defaults to the current process cwd when omitted.
#   codex_home defaults to ~/.codex when omitted.

[[agents]]
name = "supervisor"

[[agents.providers]]
provider = "codex"
model = "gpt-5-codex"
max_tokens = 2048

# [[agents.providers]]
# provider = "codex-api"
# model = "gpt-5-codex"
# max_tokens = 2048
# # Uses local Codex OAuth via `codex app-server`; no api_keys field.

[[agents.providers]]
base_url = "https://api.deepseek.com"
model = "deepseek-chat"
api_keys = [
  "env:DEEPSEEK_API_KEY",
]

